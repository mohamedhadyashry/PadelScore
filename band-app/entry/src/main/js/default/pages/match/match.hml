<!-- Lite wearables don't allow data binding in `class`, so every class here is
     fixed. Tap effects work by creating a flash layer with `if`: an element's
     animation plays when it is created, and two copies (…0 / …1) are swapped on
     each tap so the animation restarts every time. -->
<stack class="root">
    <div class="container">
        <!-- Team A: tap the top half -->
        <stack class="zone">
            <div if="{{fA0}}" class="fx flash-a0"></div>
            <div if="{{fA1}}" class="fx flash-a1"></div>
            <div if="{{bA0}}" class="fx big-a0"></div>
            <div if="{{bA1}}" class="fx big-a1"></div>
            <div class="zone-content" onclick="pointA">
                <div class="dots">
                    <div for="{{dotsA}}" class="dot dot-a"></div>
                </div>
                <text class="num num-a">{{labelA}}</text>
                <text class="team team-a">A</text>
            </div>
        </stack>

        <!-- Games: tap = undo, long-press = menu -->
        <stack class="strip">
            <div if="{{u0}}" class="fx-strip undo0"></div>
            <div if="{{u1}}" class="fx-strip undo1"></div>
            <div class="strip-content" onclick="undo" onlongpress="menu">
                <text class="games">{{gamesText}}</text>
                <text class="info">{{infoText}}</text>
            </div>
        </stack>

        <!-- Team B: tap the bottom half -->
        <stack class="zone">
            <div if="{{fB0}}" class="fx flash-b0"></div>
            <div if="{{fB1}}" class="fx flash-b1"></div>
            <div if="{{bB0}}" class="fx big-b0"></div>
            <div if="{{bB1}}" class="fx big-b1"></div>
            <div class="zone-content" onclick="pointB">
                <text class="team team-b">B</text>
                <text class="num num-b">{{labelB}}</text>
                <div class="dots">
                    <div for="{{dotsB}}" class="dot dot-b"></div>
                </div>
            </div>
        </stack>
    </div>

    <!-- Match over -->
    <div if="{{showWin}}" class="win" onclick="finish" onlongpress="undo">
        <text class="win-small">WINNER</text>
        <text if="{{winA}}" class="win-team win-a">TEAM A</text>
        <text if="{{winB}}" class="win-team win-b">TEAM B</text>
        <text class="win-sets">{{finalSets}}</text>
        <text class="win-small">HOLD = UNDO</text>
    </div>
</stack>
